{
  "name": "gitboard-canvas",
  "version": "0.2.0",
  "description": "GitBoard Canvas: a local kanban for a folder-based product lifecycle. Each feature is a folder; moving a card is a git commit.",
  "license": "MIT",
  "author": "Josh O'Sullivan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoshOsullivan-au/GitBoardCanvas.git"
  },
  "bugs": {
    "url": "https://github.com/JoshOsullivan-au/GitBoardCanvas/issues"
  },
  "homepage": "https://github.com/JoshOsullivan-au/GitBoardCanvas#readme",
  "type": "module",
  "bin": {
    "gitboard-canvas": "dist/cli.js",
    "gitboard": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build --logLevel warn && node scripts/copy-ui.mjs && node scripts/stamp-build.mjs",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json",
    "test": "vitest run",
    "dev": "npm run build && node dist/cli.js serve",
    "check": "npm run typecheck && npm run build && npm test",
    "preversion": "npm run check",
    "version": "node scripts/changelog.mjs release && git add CHANGELOG.md"
  },
  "dependencies": {
    "marked": "^18.1.1"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "keywords": [
    "kanban",
    "roadmap",
    "git",
    "worktree",
    "product-lifecycle",
    "local-first"
  ]
}
