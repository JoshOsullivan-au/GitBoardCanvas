#!/bin/sh
# SPDX-License-Identifier: MIT
# Refuse a push whose commits name another project, in an added line or a message (see .githooks/private-terms).
here=$(dirname "$0")
zero=0000000000000000000000000000000000000000
while read -r _ local_sha _ remote_sha; do
	[ "$local_sha" = "$zero" ] && continue
	if [ "$remote_sha" = "$zero" ]; then range="$local_sha --not --remotes"; else range="$remote_sha..$local_sha"; fi
	# shellcheck disable=SC2086
	{ git log --format=%B $range; git log -p --format= $range | grep '^+' | grep -v '^+++'; } | "$here/private-terms" "the push" || { echo "pre-push: nothing was pushed" >&2; exit 1; }
done
exit 0
